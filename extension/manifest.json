{
  "manifest_version": 3,
  "name": "Rotation Planner Grades",
  "version": "0.2.2",
  "description": "Brings your Schoology grades into Rotation Planner. Student-made; not affiliated with Bolles or Schoology.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.schoology.com/*"
      ],
      "js": [
        "parse-grades.js",
        "common.js",
        "schoology.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://legoneil.github.io/rotation-planner/*",
        "https://legoneil.github.io/bolles-planner/*",
        "http://localhost:4173/*"
      ],
      "js": [
        "planner.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://*.schoology.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
